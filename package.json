{
  "name": "shuffle-pdf",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsrs --noEmit --fast && vite build",
    "preview": "vite preview",
    "typecheck": "tsrs --noEmit --fast",
    "lint": "TSRS_FAST=1 oxlint --type-aware .",
    "lint:fix": "TSRS_FAST=1 oxlint --type-aware --fix .",
    "test": "node --test tests/seo-html.test.ts",
    "test:dist": "node --test tests/dist.test.ts",
    "format": "prettier --write src",
    "format:check": "prettier --check src"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "tsrs": "7.1.0-beta.tsrs5",
    "oxlint": "1.95.0"
  }
}
